# VENOM API keys - create keys at the provider dashboards.
# Keep your real .env private. Never commit real API keys.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
# Optional: legacy paid provider (not required for free setup)
# ANTHROPIC_API_KEY=
# Optional model overrides
# VENOM_GEMINI_MODEL=gemini-3.8-flash
# VENOM_GROQ_MODEL=openai/gpt-oss-120b
# VENOM_OPENROUTER_MODEL=openrouter/free
# VENOM_MISTRAL_MODEL=mistral-small-latest

# Optional personal signature details (kept only in your local .env)
VENOM_SIGNATURE=Your Name
VENOM_INSTAGRAM=
VENOM_PUBLIC_WHATSAPP=
# Optional OpenAI API model (API usage is billed separately from ChatGPT)
# VENOM_OPENAI_MODEL=gpt-6-luna
